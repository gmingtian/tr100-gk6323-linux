diff --git a/WIFI/cmdevt.c b/WIFI/cmdevt.c
index 26004c5..223029f 100755
--- a/WIFI/cmdevt.c
+++ b/WIFI/cmdevt.c
@@ -253,6 +253,10 @@ int sprdwl_cmd_init(void)
 	struct sprdwl_cmd *cmd = &g_sprdwl_cmd;
 	/* memset(cmd, 0, sizeof(*cmd)); */
 	cmd->data = NULL;
+	cmd->wake_lock = NULL;
+	cmd->init_ok = 0;
+	atomic_set(&cmd->refcnt, 0);
+#if IS_ENABLED(CONFIG_PM_SLEEP)
 #ifdef CONFIG_WIFI_RK_PM_PRIVATE_API
 	cmd->wake_lock = wakeup_source_register(sprdwl_dev,
 						"Wi-Fi_cmd_wakelock");
@@ -267,6 +271,7 @@ int sprdwl_cmd_init(void)
 		wl_err("%s wakeup source register error.\n", __func__);
 		return -EINVAL;
 	}
+#endif /* CONFIG_PM_SLEEP */
 
 	spin_lock_init(&cmd->lock);
 	mutex_init(&cmd->cmd_lock);
@@ -330,6 +335,8 @@ void sprdwl_cmd_deinit(void)
 	mutex_destroy(&cmd->cmd_lock);
 	if (cmd->wake_lock)
 		wakeup_source_unregister(cmd->wake_lock);
+	cmd->wake_lock = NULL;
+	cmd->init_ok = 0;
 }
 
