+/* SDIO1 card-present override required by this soldered TR100 Wi-Fi. */
+static int gkmciv300_tr100_wifi_detect(struct platform_device *pdev,
+                                      struct gkmciv300_host *host)
+{
+ struct resource *res;
+ void __iomem *ctrl;
+
+ if (!of_property_read_bool(pdev->dev.of_node,
+                            "tr100,force-wifi-card-detect"))
+  return 0;
+ if (!(host->mmc->caps & MMC_CAP_NONREMOVABLE))
+  return -EINVAL;
+ res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+ if (!res || res->start != 0xf9c40000)
+  return -EINVAL;
+ res = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+ if (!res || res->start != 0xf8a20008 || resource_size(res) < sizeof(u32))
+  return -EINVAL;
+ ctrl = devm_ioremap_resource(&pdev->dev, res);
+ if (IS_ERR(ctrl))
+  return PTR_ERR(ctrl);
+ writel(readl(ctrl) | BIT(0), ctrl);
+ readl(ctrl);
+ host->tr100_fixed_wifi = true;
+ dev_info(&pdev->dev, "TR100 fixed Wi-Fi card-detect enabled; hotplug timer disabled\n");
+ return 0;
+}
