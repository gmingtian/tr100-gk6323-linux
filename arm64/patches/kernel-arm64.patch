+// SPDX-License-Identifier: GPL-2.0
+/* Import selected firmware ATAGS without replacing the ARM64 device tree. */
+#include <linux/init.h>
+#include <linux/export.h>
+#include <linux/io.h>
+#include <linux/memblock.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include "gk_arm64_boot_params.h"
+
+u64 g_ddrsize;
+u32 g_emmc_boot_tuning_phase = 3;
+u32 g_emmc_boot_dll_element;
+bool g_emmc_boot_params_valid;
+static char g_sdk_version[64] = "unknown";
+static unsigned char g_params[2048];
+static unsigned g_params_len;
+static DEFINE_SPINLOCK(g_params_lock);
+
+const char *get_sdkversion(void) { return g_sdk_version; }
+EXPORT_SYMBOL(get_sdkversion);
+
+int get_param_data(const char *name, char *buf, unsigned int buflen)
+{
+ const unsigned char *data; unsigned size; unsigned long irqflags;
+ int ret;
+ if (!name || !*name || !buf) return -2;
+ spin_lock_irqsave(&g_params_lock, irqflags);
+ ret = gk_boot_param_find(g_params, g_params_len, name, &data, &size);
+ if (ret != 1) { ret = -1; goto out; }
+ if (size > buflen) { ret = -2; goto out; }
+ memcpy(buf, data, size); ret = size;
+ out: spin_unlock_irqrestore(&g_params_lock, irqflags); return ret;
+}
+EXPORT_SYMBOL(get_param_data);
+
+int set_param_data(const char *name, char *buf, unsigned int buflen)
+{
+ const unsigned char *data; unsigned size; unsigned long irqflags; int ret;
+ if (!name || !buf || strcmp(name, "pdm_tag")) return -2;
+ spin_lock_irqsave(&g_params_lock, irqflags);
+ ret = gk_boot_param_find(g_params, g_params_len, name, &data, &size);
+ if (ret != 1 || buflen > size) { ret = -2; goto out; }
+ memcpy((void *)data, buf, buflen);
+ memset((void *)data + buflen, 0, size - buflen);
+ ret = buflen;
+ out: spin_unlock_irqrestore(&g_params_lock, irqflags); return ret;
+}
+EXPORT_SYMBOL(set_param_data);
+
+/* Firmware display blobs remain reserved throughout this kernel's lifetime.
+ * The ARM32 SDK's unconditional page freeing is unsafe on ARM64. */
+int pdm_free_reserve_mem(u32 addr, u32 size)
+{
+ pr_warn_once("TR100: retaining firmware display buffers (no unsafe page release)\n");
+ return -EOPNOTSUPP;
+}
+EXPORT_SYMBOL(pdm_free_reserve_mem);
+
+int pdm_get_hashtable(u32 *addr, u32 *size)
+{
+ if (!addr || !size) return -EINVAL;
+ *addr = 0; *size = 0;
+ return 0; /* This firmware's verified PDM tag has no hash-table item. */
+}
+EXPORT_SYMBOL(pdm_get_hashtable);
+
+static int __init gk_arm64_reserve_pdm(const char *key)
+{
+ char text[512], *next, *item; int len, count = 0;
+ len = get_param_data(key, text, sizeof(text) - 1);
+ if (len == -2) return -EINVAL;
+ if (len < 0) return 0;
+ text[len] = 0; next = text;
+ while ((item = strsep(&next, " ")) != NULL) {
+  char *name, *address, *length, *flags; unsigned long base, bytes;
+  if (!*item) continue;
+  name = strsep(&item, "=");
+  if (!item) return -EINVAL;
+  if (!strcmp(name, "version")) continue;
+  address = strsep(&item, ","); length = strsep(&item, ","); flags = item;
+  if (++count > 8 || !address || !length ||
+      (flags && strcmp(flags, "nosnapshot")) ||
+      kstrtoul(address, 0, &base) || kstrtoul(length, 0, &bytes) ||
+      !bytes || (base | bytes) & (PAGE_SIZE - 1) ||
+      base >= SZ_2G || bytes > SZ_2G - base ||
+      !memblock_is_region_memory(base, bytes) ||
+      memblock_is_region_reserved(base, bytes)) return -EINVAL;
+  if (memblock_reserve(base, bytes)) return -ENOMEM;
+  pr_info("TR100 ARM64: reserved firmware %s at %lx size %lx\n", name, base, bytes);
+ }
+ return 0;
+}
+
+/* Called after the DT/kernel reservations, before paging/buddy allocation. */
+void __init gk_arm64_import_boot_params_early(void)
+{
+ const unsigned char *tags; unsigned offset = 0x100;
+ tags = early_memremap(0, SZ_4K);
+ if (!tags) panic("TR100: cannot map firmware parameters");
+ while (offset <= SZ_4K - 8) {
+  u32 words = gk_boot_le32(tags + offset), tag = gk_boot_le32(tags + offset + 4);
+  unsigned bytes;
+  if (!words || words < 2 || words > (SZ_4K - offset) / 4) break;
+  bytes = (words - 2) * 4;
+  if (tag == 0x726d6d75 && bytes) {
+   unsigned n = min_t(unsigned, bytes, sizeof(g_sdk_version) - 1);
+   memcpy(g_sdk_version, tags + offset + 8, n); g_sdk_version[n] = 0;
+  } else if (tag == 0x70000001 && bytes <= sizeof(g_params)) {
+   memcpy(g_params, tags + offset + 8, bytes); g_params_len = bytes;
+  } else if (tag == 0x48694e7b && words >= 5) {
+   u32 phase = gk_boot_le32(tags + offset + 12) & 0xff;
+   if (!gk_boot_le32(tags + offset + 8) && phase <= 7) {
+    g_emmc_boot_tuning_phase = phase;
+    g_emmc_boot_dll_element = gk_boot_le32(tags + offset + 16) & 0xff;
+    g_emmc_boot_params_valid = true;
+   }
+  }
+  offset += words * 4;
+ }
+ early_memunmap((void *)tags, SZ_4K);
+ if (!g_emmc_boot_params_valid) panic("TR100: valid eMMC boot tuning missing");
+ {
+  const unsigned char *unused; unsigned unused_size;
+  if (!g_params_len || gk_boot_param_find(g_params, g_params_len, "pdm_tag", &unused, &unused_size) != 1)
+   panic("TR100: malformed or missing display boot parameters");
+ }
+ if (gk_arm64_reserve_pdm("pdm_tag") || gk_arm64_reserve_pdm("hrf_tag"))
+  panic("TR100: invalid or overlapping firmware display buffers");
+ pr_info("GK6323 ARM64 boot tuning: phase=%u element=%u SDK=%s\n",
+  g_emmc_boot_tuning_phase, g_emmc_boot_dll_element, g_sdk_version);
+}
--- a/drivers/goke/gk_arm64_boot_params.h
+++ b/drivers/goke/gk_arm64_boot_params.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef GK_ARM64_BOOT_PARAMS_H
+#define GK_ARM64_BOOT_PARAMS_H
+static inline unsigned gk_boot_le16(const unsigned char *p)
+{ return (unsigned)p[0] | (unsigned)p[1] << 8; }
+static inline unsigned gk_boot_le32(const unsigned char *p)
+{ return gk_boot_le16(p) | gk_boot_le16(p + 2) << 16; }
+/* Validate every item before returning a pointer into the permanent buffer. */
+static inline int gk_boot_param_find(const unsigned char *b, unsigned len,
+ const char *name, const unsigned char **data, unsigned *size)
+{
+ unsigned count, bytes, table, i; const unsigned char *match = 0; unsigned match_len = 0;
+ if (len < 12 || len > 2048) return -1;
+ count = gk_boot_le32(b + 4); bytes = gk_boot_le32(b + 8);
+ if (bytes > len - 12 || count > bytes / 12) return -1;
+ table = count * 12;
+ for (i = 0; i < count; i++) {
+  const unsigned char *item = b + 12 + i * 12;
+  unsigned off = gk_boot_le16(item + 8), n = gk_boot_le16(item + 10);
+  if (off > bytes - table || n > bytes - table - off) return -1;
+  if (!strncmp((const char *)item, name, 8)) { match = b + 12 + table + off; match_len = n; }
+ }
+ if (!match) return 0;
+ *data = match; *size = match_len; return 1;
+}
+#endif
