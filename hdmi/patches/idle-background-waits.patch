--- /dev/null
+++ b/source/common/drv/include/gk_thread_idle.h
@@ -0,0 +1,17 @@
+#ifndef __GK_THREAD_IDLE_H__
+#define __GK_THREAD_IDLE_H__
+
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+
+/* msleep timing/retry semantics for background polling, without load charge. */
+static inline void gk_msleep_idle(unsigned int msecs)
+{
+    unsigned long timeout = msecs_to_jiffies(msecs) + 1;
+
+    while (timeout) {
+        timeout = schedule_timeout_idle(timeout);
+    }
+}
+
+#endif
