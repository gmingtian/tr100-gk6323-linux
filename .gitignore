# Defense in depth: generated binaries, private data and third-party downloads never enter Git.
**/node_modules/
**/vendor/
**/vendor-selected/
**/upstream/
**/runtime/
**/wheels/
**/__pycache__/
**/factory-backup/
**/backups/
**/serial-logs/
**/known_hosts*
**/.ssh/
**/id_rsa*
**/id_ed25519*
**/ssh_host_*_key*
**/*.bin
**/*.img
**/*.raw
**/*.ext4
**/*.gz
**/*.xz
**/*.bz2
**/*.tar
**/*.tgz
**/*.cpio
**/*.deb
**/*.zip
**/*.7z
**/*.whl
**/*.exe
**/*.dll
**/*.pyd
**/*.pyc
**/*.ko
**/SHA256SUMS
**/receipt.json
**/*-inputs.json
**/.identity-fixture-*/
**/.network-fixture-*/
**/.policy-outside-fixture-*/

# Publish the reviewed guide and its source only; keep render QA local.
!/docs/
/docs/*
!/docs/TR100纯Linux刷入指南.html
!/docs/build_flashing_guide.py
!/docs/examples/
/docs/examples/*
!/docs/examples/final-environment-commit-reference.sh
